{
	"functions": {
		"source": "functions"
	},
	"firestore": {
		"rules": "firestore.rules"
	},
	"storage": {
		"rules": "storage.rules"
	},
	"hosting": {
		"public": ".",
		"headers": [
			{
				"source": "**",
				"headers": [
					{
						"key": "X-Content-Type-Options",
						"value": "nosniff"
					},
					{
						"key": "X-Frame-Options",
						"value": "DENY"
					},
					{
						"key": "Referrer-Policy",
						"value": "strict-origin-when-cross-origin"
					},
					{
						"key": "Permissions-Policy",
						"value": "camera=(), microphone=(), geolocation=()"
					},
					{
						"key": "Strict-Transport-Security",
						"value": "max-age=31536000; includeSubDomains"
					}
				]
			},
			{
				"source": "**/*.html",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "no-cache, no-store, must-revalidate"
					}
				]
			},
			{
				"source": "**/*.js",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "no-cache, no-store, must-revalidate"
					}
				]
			}
		],
		"redirects": [
		],
		"ignore": [
			"firebase.json",
			"deploy.log",
			"__tmp_*",
			".git/**",
			"**/.*",
			"**/node_modules/**"
		]
	}
}
