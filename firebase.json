{
	"functions": {
		"source": "functions"
	},
	"firestore": {
		"rules": "firestore.rules"
	},
	"storage": {
		"rules": "storage.rules"
	},
	"hosting": {
		"public": ".",
		"headers": [
			{
				"source": "**/*.html",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "no-cache, no-store, must-revalidate"
					}
				]
			},
			{
				"source": "**/script.js",
				"headers": [
					{
						"key": "Cache-Control",
						"value": "no-cache, no-store, must-revalidate"
					}
				]
			}
		],
		"redirects": [
			{
				"source": "/",
				"destination": "/index.html",
				"type": 302
			}
		],
		"ignore": [
			"firebase.json",
			"deploy.log",
			"__tmp_*",
			".git/**",
			"**/.*",
			"**/node_modules/**"
		]
	}
}
