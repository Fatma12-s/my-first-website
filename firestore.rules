rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedFormType(formType) {
      return formType == 'graduates'
        || formType == 'internal-employees'
        || formType == 'internal-others'
        || formType == 'training-employees'
        || formType == 'training-others'
        || formType == 'contact';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidPublicSubmissionCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['formType', 'status', 'submittedAt', 'createdAt', 'id'])
        && !data.keys().hasAny(['reviewedAt', 'reviewNote', 'managerSection2'])
        && data.formType is string
        && isAllowedFormType(data.formType)
        && data.status == 'Pending'
        && data.submittedAt is string
        && data.createdAt is string
        && data.id is int;
    }

    match /formSubmissions/{docId} {
      allow create: if isValidPublicSubmissionCreate();
      allow read, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}